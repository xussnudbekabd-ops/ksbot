# --- Telegram bot ---
# @BotFather dan olingan token (faqat shu botga tegishli)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# --- Adminlar ---
# Admin Telegram ID lar (vergul bilan bir nechta bo'lishi mumkin) — o'zingiznikini yozing
ADMIN_IDS=111111111
# Admin panelga kirish paroli — o'zgartiring
ADMIN_PASSWORD=parolni_kiriting
# Admin telefon raqami (xabarlar va PDF da kontakt sifatida ko'rsatiladi)
ADMIN_PHONE=+998 00 000 00 00

# --- Kurs haqida ---
# Bot xabarlarida chiqadigan umumiy nom
COURSE_NAME=Kompyuter savodxonligi kursi
# Narxi (faqat ko'rsatish uchun, to'lov qayd etilmaydi)
COURSE_PRICE=100.000 so'm
# So'rovnomada o'quvchi kiritadigan yo'nalish uchun namuna
DIRECTION_EXAMPLE=Tarix - B guruh
# Kurs nomi — barcha o'quvchilar uchun bir xil
COURSE=Kompyuter savodxonligi kursi

# Dars vaqtlari (o'quvchi bo'sh vaqtlarini shundan tanlaydi)
TIME_SLOTS=10:00, 11:00, 12:00, 13:00, 14:00, 15:00, 16:00, 17:00, 18:00, 19:00

# --- Texnik ---
# SQLite fayli joylashuvi
DB_FILE=data/bot.db
# PDF shrifti (bo'sh qoldirilsa tizim shrifti avtomatik tanlanadi)
PDF_FONT=
